<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
            <title>Academic Summit | Intelligent GPA System</title>
                <script src="https://cdn.tailwindcss.com"></script>
                    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
                        <style>
                                :root {
                                	            /* Light Mode Colors */
                                	                        --bg-primary: #f8fafc;
                                	                                    --bg-secondary: #ffffff;
                                	                                                --bg-tertiary: #f1f5f9;
                                	                                                            --text-primary: #0f172a;
                                	                                                                        --text-secondary: #475569;
                                	                                                                                    --text-tertiary: #94a3b8;
                                	                                                                                                --border-color: rgba(148, 163, 184, 0.2);
                                	                                                                                                            --glass-bg: rgba(255, 255, 255, 0.7);
                                	                                                                                                                        --glass-border: rgba(255, 255, 255, 0.3);
                                	                                                                                                                                    --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
                                	                                                                                                                                                --card-shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
                                	                                                                                                                                                        }

                                	                                                                                                                                                                [data-theme="dark"] {
                                	                                                                                                                                                                	            /* Dark Mode Colors - Sophisticated Navy/Slate */
                                	                                                                                                                                                                	                        --bg-primary: #0f172a;
                                	                                                                                                                                                                	                                    --bg-secondary: #1e293b;
                                	                                                                                                                                                                	                                                --bg-tertiary: #334155;
                                	                                                                                                                                                                	                                                            --text-primary: #f8fafc;
                                	                                                                                                                                                                	                                                                        --text-secondary: #cbd5e1;
                                	                                                                                                                                                                	                                                                                    --text-tertiary: #64748b;
                                	                                                                                                                                                                	                                                                                                --border-color: rgba(148, 163, 184, 0.1);
                                	                                                                                                                                                                	                                                                                                            --glass-bg: rgba(30, 41, 59, 0.6);
                                	                                                                                                                                                                	                                                                                                                        --glass-border: rgba(148, 163, 184, 0.1);
                                	                                                                                                                                                                	                                                                                                                                    --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -1px rgba(0, 0, 0, 0.2);
                                	                                                                                                                                                                	                                                                                                                                                --card-shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -2px rgba(0, 0, 0, 0.3);
                                	                                                                                                                                                                	                                                                                                                                                        }

                                	                                                                                                                                                                	                                                                                                                                                                body { 
                                	                                                                                                                                                                	                                                                                                                                                                            font-family: 'Inter', sans-serif; 
                                	                                                                                                                                                                	                                                                                                                                                                                        background: var(--bg-primary);
                                	                                                                                                                                                                	                                                                                                                                                                                                    color: var(--text-primary);
                                	                                                                                                                                                                	                                                                                                                                                                                                                overflow-x: hidden;
                                	                                                                                                                                                                	                                                                                                                                                                                                                            -webkit-tap-highlight-color: transparent;
                                	                                                                                                                                                                	                                                                                                                                                                                                                                        transition: background 0.3s ease, color 0.3s ease;
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                        /* Animated Background Gradient */
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                .bg-gradient-animate {
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	            background: linear-gradient(-45deg, #667eea, #764ba2, #f093fb, #4facfe);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                        background-size: 400% 400%;
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                    animation: gradient 15s ease infinite;
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                            }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    @keyframes gradient {
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	            0% { background-position: 0% 50%; }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                        50% { background-position: 100% 50%; }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                    100% { background-position: 0% 50%; }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                            }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                    /* Glassmorphism */
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                            .glass { 
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                        background: var(--glass-bg); 
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                    backdrop-filter: blur(20px); 
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                -webkit-backdrop-filter: blur(20px); 
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                            border: 1px solid var(--glass-border);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                        box-shadow: var(--card-shadow);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                    transition: all 0.3s ease;
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                            }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                            .glass-heavy { 
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                        background: var(--glass-bg); 
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                    backdrop-filter: blur(24px); 
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                border: 1px solid var(--glass-border);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                            box-shadow: var(--card-shadow-lg);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                    }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            .glass:hover {
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	            box-shadow: var(--card-shadow-lg);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                        transform: translateY(-2px);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                /* Utilities */
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                        .hidden-screen { display: none !important; }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                .fade-in { animation: fadeIn 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                        @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                        /* Gradients */
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                .grad-purple { background: linear-gradient(135deg, #8b5cf6, #d946ef); }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                        .grad-cyan { background: linear-gradient(135deg, #06b6d4, #3b82f6); }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                .grad-pink { background: linear-gradient(135deg, #ec4899, #f43f5e); }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                        .grad-green { background: linear-gradient(135deg, #10b981, #84cc16); }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                .grad-orange { background: linear-gradient(135deg, #f59e0b, #ef4444); }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                        .text-grad { background: linear-gradient(to right, #8b5cf6, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                        /* Loader */
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                .loader { border: 3px solid var(--border-color); border-left-color: #8b5cf6; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                /* Custom Scrollbar */
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                        .custom-scroll::-webkit-scrollbar { height: 6px; }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                .custom-scroll::-webkit-scrollbar-track { background: var(--bg-tertiary); }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                        .custom-scroll::-webkit-scrollbar-thumb { background: var(--text-tertiary); border-radius: 3px; }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                /* Input Styles */
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        input, select {
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	            background: var(--bg-tertiary);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                        border: 1px solid var(--border-color);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                    color: var(--text-primary);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                transition: all 0.2s ease;
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                        }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        input:focus, select:focus {
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	            border-color: #8b5cf6;
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                        /* Button Hover Effects */
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                button {
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	            transition: all 0.2s ease;
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                    }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    button:active {
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	            transform: scale(0.98);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                    }

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                            /* Card Hover */
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    .hover-lift:hover {
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	            transform: translateY(-4px);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                        box-shadow: var(--card-shadow-lg);
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                }
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                    </style>
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                    </head>
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                    <body class="min-h-screen flex items-center justify-center p-3 md:p-6">

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                        <!-- Theme Toggle (Fixed Position) -->
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                            <button onclick="toggleTheme()" class="fixed top-4 right-4 z-50 glass p-3 rounded-full hover-lift" id="theme-toggle">
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                    <span id="theme-icon" class="text-xl">🌙</span>
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                        </button>

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                            <!-- ========================================== -->
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                <!-- 1. WELCOME BEACH                           -->
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                    <!-- ========================================== -->
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                        <div id="screen-welcome" class="w-full max-w-md text-center fade-in py-10">
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                <div class="glass-heavy rounded-3xl p-10">
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                            <div class="text-7xl mb-6 drop-shadow-2xl">🏔️</div>
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                        <h1 class="text-5xl font-black mb-4 tracking-tight">Academic <span class="text-grad">Summit</span></h1>
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                    <p class="text-sm mb-10 leading-relaxed px-2" style="color: var(--text-secondary);">
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                    Academic success isn't an accident. It's the result of intentionality, strategy, and relentless execution. Welcome to your confidential command center.
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                </p>
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                            <button onclick="goTo('screen-auth')" class="w-full py-4 rounded-2xl font-bold text-white text-lg grad-purple shadow-lg shadow-purple-500/30 hover:shadow-purple-500/50 transition">
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                            Begin Journey ➔
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                                        </button>
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                                                </div>
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                                                    </div>

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                                                        <!-- ========================================== -->
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                                                            <!-- 2. AUTHENTICATION                          -->
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                                                                <!-- ========================================== -->
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                                                                    <div id="screen-auth" class="w-full max-w-md glass-heavy rounded-3xl p-8 fade-in hidden-screen">
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                                                                            <h2 class="text-2xl font-bold mb-2 text-center">Identify Yourself</h2>
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                                                                                    <p class="text-center mb-8 text-sm" style="color: var(--text-tertiary);">Secure. Confidential. Yours.</p>

                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                                                                                                    <!-- Tabs -->
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                                                                                                            <div class="flex border-b mb-6" style="border-color: var(--border-color);">
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                                                                                                                        <button class="flex-1 pb-2 text-purple-500 border-b-2 border-purple-500 font-semibold text-sm">Login</button>
                                	                                                                                                                                                                	                                                                                                                                                                                                                                                                	                                                    	                                                                                                                                                                                                                            	                                                                                                                                                                                                                        	                                                                        	                                                	                                    	                                    	                                                                                                                                                                                                                                                                                    <button class="flex-1 pb-2 font-semibold text-sm" style="color: var(--text-tertiary);">Sign Up</button>
